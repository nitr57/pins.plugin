<UserControl
    x:Class="NINA.PINS.Resources.Styles.DewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:NINA.PINS.Resources.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NINA.PINS.Resources.Styles"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary"
    xmlns:util="clr-namespace:NINA.Core.Utility.ValidationRules;assembly=NINA.Core"
    x:Name="DewControlRoot"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:DutyCycleToPercentageConverter x:Key="DutyCycleToPercentageConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>
    <Grid>
        <StackPanel
            Margin="0,5,0,0"
            Orientation="Horizontal"
            Visibility="{Binding PortOvercurrent, ElementName=DewControlRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock VerticalAlignment="Center" Text="Overcurrent occurred on" />
            <TextBlock
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding PortName, ElementName=DewControlRoot}" />
            <TextBlock
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Text="(" />
            <TextBlock VerticalAlignment="Center" Text="{Binding PortText, ElementName=DewControlRoot}" />
            <TextBlock VerticalAlignment="Center" Text=")" />
            <Button MinWidth="80" Margin="5,0,0,0">
                <Button.Command>
                    <Binding Path="PortCommand" />
                </Button.Command>
                <TextBlock Foreground="{StaticResource ButtonForegroundBrush}" Text="Clear" />
            </Button>
        </StackPanel>
        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PortOvercurrent, ElementName=DewControlRoot}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBox
                x:Name="MyTextBox"
                Grid.Column="1"
                Width="120"
                Height="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Text="{Binding PortText, ElementName=DewControlRoot, UpdateSourceTrigger=LostFocus}"
                TextWrapping="NoWrap" />
            <CheckBox
                Margin="10,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsChecked="{Binding PortState, ElementName=DewControlRoot, Mode=TwoWay}" />
            <TextBlock
                Width="40"
                Height="20"
                Margin="10,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{Binding PortCurrent, StringFormat='{}{0} A', ElementName=DewControlRoot}" />
            <TextBlock
                Width="40"
                Height="20"
                Margin="10,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource DutyCycleToPercentageConverter}">
                        <Binding ElementName="DewControlRoot" Path="PortValue" />
                        <Binding ElementName="DewControlRoot" Path="PortDutyCycle" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock
                Width="50"
                Height="20"
                Margin="10,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{Binding PortTemperature, StringFormat='{}{0}°C', ElementName=DewControlRoot}" />
            <ninactrl:IntStepperControl
                MinWidth="80"
                MinHeight="20"
                Margin="5,0,0,0"
                IsEnabled="{Binding IsChecked, ElementName=AutoDew, Converter={StaticResource InverseBooleanConverter}}"
                MaxValue="{Binding PortDutyCycle, ElementName=DewControlRoot}"
                MinValue="0"
                StepSize="1"
                Value="{Binding PortSetPower, ElementName=DewControlRoot}" />
            <Button
                MinWidth="40"
                Margin="10,0,0,0"
                Click="SetButton_Click"
                IsEnabled="{Binding IsChecked, ElementName=AutoDew, Converter={StaticResource InverseBooleanConverter}}">
                <TextBlock Foreground="{StaticResource ButtonForegroundBrush}" Text="Set" />
            </Button>
            <TextBlock
                Height="20"
                Margin="10,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="Auto dew" />
            <CheckBox
                Name="AutoDew"
                Margin="5,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsChecked="{Binding PortAutoDew, ElementName=DewControlRoot}" />
            <TextBlock
                Width="50"
                Height="20"
                Margin="10,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="Delta T" />
            <ninactrl:UnitTextBox Unit="°C">
                <ninactrl:UnitTextBox.Text>
                    <Binding
                        ElementName="DewControlRoot"
                        Path="PortDeltaT"
                        UpdateSourceTrigger="LostFocus">
                        <Binding.ValidationRules>
                            <util:DoubleRangeRule>
                                <util:DoubleRangeRule.ValidRange>
                                    <util:DoubleRangeChecker Maximum="25.5" Minimum="0.1" />
                                </util:DoubleRangeRule.ValidRange>
                            </util:DoubleRangeRule>
                        </Binding.ValidationRules>
                    </Binding>
                </ninactrl:UnitTextBox.Text>
            </ninactrl:UnitTextBox>
        </StackPanel>
    </Grid>
</UserControl>