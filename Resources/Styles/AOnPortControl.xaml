<UserControl
    x:Class="NINA.PINS.Resources.Styles.AOnPortControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:NINA.PINS.Resources.Styles"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="AOnPortControlRoot"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
        <TextBox
            x:Name="MyTextBox"
            Grid.Column="1"
            Width="120"
            Height="20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center"
            Text="{Binding PortText, ElementName=AOnPortControlRoot, UpdateSourceTrigger=LostFocus}"
            TextWrapping="NoWrap" />
        <CheckBox
            Margin="10,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsChecked="True"
            IsEnabled="False" />
        <TextBlock
            Width="40"
            Height="20"
            Margin="10,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{Binding PortCurrent, StringFormat='{}{0} A', ElementName=AOnPortControlRoot}" />
        <TextBlock
            Height="18"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Text="Always on" />
    </StackPanel>
</UserControl>