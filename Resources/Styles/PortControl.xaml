<UserControl
    x:Class="NINA.PINS.Resources.Styles.PortControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NINA.PINS.Resources.Styles"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="PortControlRoot"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:NaNToDashConverter x:Key="NaNToDashConverter" />
    </UserControl.Resources>
    <Grid>
        <StackPanel
            Margin="0,5,0,0"
            Orientation="Horizontal"
            Visibility="{Binding PortOvercurrent, ElementName=PortControlRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock VerticalAlignment="Center" Text="Overcurrent occurred on" />
            <TextBlock
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding PortName, ElementName=PortControlRoot}" />
            <!--  Port still on: the over current switch-off failed (the box retries it)  -->
            <TextBlock
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Text="- switch-off failed, port still on"
                Visibility="{Binding PortState, ElementName=PortControlRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <!--  Switching the port clears the over current flag: "Switch on" for a port
                  that was switched off, "Switch off" for a port whose switch-off failed  -->
            <Button
                MinWidth="80"
                Margin="5,0,0,0"
                Click="OvercurrentButton_Click"
                ToolTip="Switches the port and clears the over current flag">
                <TextBlock Foreground="{StaticResource ButtonForegroundBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Switch on" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PortState, ElementName=PortControlRoot}" Value="True">
                                    <Setter Property="Text" Value="Switch off" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
        </StackPanel>
        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PortOvercurrent, ElementName=PortControlRoot}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBox
                x:Name="MyTextBox"
                Grid.Column="1"
                Width="120"
                Height="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Text="{Binding PortText, ElementName=PortControlRoot, UpdateSourceTrigger=LostFocus}"
                TextWrapping="NoWrap" />
            <CheckBox
                Margin="10,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsChecked="{Binding PortState, ElementName=PortControlRoot, Mode=TwoWay}" />
            <TextBlock
                Width="40"
                Height="20"
                Margin="10,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{Binding PortCurrent, ElementName=PortControlRoot, Converter={StaticResource NaNToDashConverter}, ConverterParameter=A}" />
            <TextBlock
                Height="18"
                Margin="10,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="Bootstrap" />
            <CheckBox
                Margin="10,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsChecked="{Binding PortBootstrap, ElementName=PortControlRoot, Mode=TwoWay}" />
        </StackPanel>
    </Grid>
</UserControl>