<UserControl
    x:Class="NINA.PINS.Resources.Styles.PropertyConfig"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NINA.PINS.Resources.Styles"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary"
    xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core"
    xmlns:util="clr-namespace:NINA.Core.Utility.ValidationRules;assembly=NINA.Core"
    x:Name="PropertyConfigRoot"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0">
        <UniformGrid
            Margin="0,6,0,6"
            VerticalAlignment="Center"
            Columns="2">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding PropertyName, ElementName=PropertyConfigRoot}"
                    ToolTip="{Binding PropertyToolTip, ElementName=PropertyConfigRoot}" />
                <StackPanel Opacity="0.4" Orientation="Horizontal">
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="(" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding PropertyMin, ElementName=PropertyConfigRoot}" />
                    <TextBlock VerticalAlignment="Center" Text=" - " />
                    <TextBlock VerticalAlignment="Center" Text="{Binding PropertyMax, ElementName=PropertyConfigRoot}" />
                    <TextBlock VerticalAlignment="Center" Text=")" />
                </StackPanel>
            </StackPanel>
            <ninactrl:UnitTextBox Unit="{Binding PropertyUnit, ElementName=PropertyConfigRoot}">
                <ninactrl:UnitTextBox.Text>
                    <Binding
                        ElementName="PropertyConfigRoot"
                        Path="PropertyValue"
                        UpdateSourceTrigger="LostFocus">
                        <Binding.ValidationRules>
                            <util:DoubleRangeRule>
                                <util:DoubleRangeRule.ValidRange>
                                    <util:DoubleRangeChecker Maximum="{Binding PropertyMax, ElementName=PropertyConfigRoot}" Minimum="{Binding PropertyMin, ElementName=PropertyConfigRoot}" />
                                </util:DoubleRangeRule.ValidRange>
                            </util:DoubleRangeRule>
                        </Binding.ValidationRules>
                    </Binding>
                </ninactrl:UnitTextBox.Text>
            </ninactrl:UnitTextBox>
        </UniformGrid>
    </Border>
</UserControl>