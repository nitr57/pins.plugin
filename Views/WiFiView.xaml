<UserControl
    x:Class="NINA.PINS.Views.WiFiView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:NINA.PINS.Resources.Converters"
    xmlns:ctrl="clr-namespace:NINA.PINS.Resources.Styles"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NINA.PINS.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:RSSIToSignalConverter x:Key="RSSIToSignalConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!--  Environment  -->
        <ctrl:EnvHeader
            EnvCurrent="{Binding PowerSupply.Supply12A}"
            EnvDewPoint="{Binding DewPoint}"
            EnvHumidity="{Binding Humidity}"
            EnvTemperature="{Binding Temperature}"
            EnvUpTime="{Binding UpTimeFormatted}"
            EnvVoltage="{Binding PowerSupply.Supply12V}" />

        <!--  WiFi Entry  -->
        <GroupBox Grid.Row="1" Header="Info">
            <StackPanel Margin="0,5,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Width="90"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="SSID:" />
                    <TextBlock
                        Width="90"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{Binding WiFi.SSID}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Width="90"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="AP mode:" />
                    <TextBlock
                        Width="90"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{Binding WiFi.Mode}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Width="90"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="RSSI:" />
                    <TextBlock
                        Width="90"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{Binding WiFi.RSSI}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Width="90"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="IP address:" />
                    <TextBlock
                        Width="90"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{Binding WiFi.IPAddress}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Width="90"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="Hostname:" />
                    <TextBlock
                        Width="150"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{Binding WiFi.HostName}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <!--  Hotspot config  -->
        <GroupBox Grid.Row="2" Header="HotSpot config">
            <StackPanel>
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="90"
                        Height="20"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="WiFi name:" />
                    <TextBox
                        MinWidth="120"
                        Margin="10,5,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Text="{Binding WiFiSSID}" />
                </StackPanel>
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="90"
                        Height="20"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="WiFi password" />
                    <PasswordBox
                        x:Name="passwordBox"
                        MinWidth="120"
                        Margin="10,5,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        PasswordChanged="Hotspot_PasswordChanged" />
                    <TextBlock
                        x:Name="errorLabel"
                        Margin="10"
                        Foreground="{StaticResource ErrorColorBrush}"
                        Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <Button
                        x:Name="HotspotButton"
                        Width="100"
                        Height="25"
                        Margin="120,5,0,5"
                        Command="{Binding WiFiHotspotCommand}"
                        IsEnabled="False">
                        <Button.Content>
                            <TextBlock Foreground="{StaticResource ButtonForegroundBrush}" Text="Create hotspot" />
                        </Button.Content>
                    </Button>
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <!--  WiFi Client settings  -->
        <GroupBox
            Grid.Row="2"
            Grid.Column="1"
            Header="Client config">
            <StackPanel>
                <ListView
                    x:Name="surveyList"
                    MaxHeight="300"
                    VerticalAlignment="Top"
                    ItemsSource="{Binding WiFiNetworks}"
                    SelectedItem="{Binding SelectedWiFiNetwork, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="Auto" Header="SSID">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{Binding SSID}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="Auto" Header="RSSI">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding RSSI}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="Auto" Header="Signal">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding RSSI, Converter={StaticResource RSSIToSignalConverter}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="90"
                        Height="20"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="WiFi password:" />
                    <PasswordBox
                        x:Name="passwordBox2"
                        MinWidth="120"
                        Margin="10,5,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsEnabled="{Binding SelectedItem, ElementName=surveyList, Converter={StaticResource InverseNullToBooleanConverter}}"
                        PasswordChanged="Client_PasswordChanged" />
                    <TextBlock
                        x:Name="errorLabel2"
                        Margin="10"
                        Foreground="{StaticResource ErrorColorBrush}"
                        Visibility="Collapsed" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Margin="0,5,0,0"
                    Orientation="Horizontal">
                    <Button
                        Width="100"
                        Height="25"
                        Margin="0,5,0,5"
                        Command="{Binding WiFiSurveyCommand}">
                        <Button.Content>
                            <TextBlock Foreground="{StaticResource ButtonForegroundBrush}" Text="Survey" />
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="ConnectButton"
                        Width="100"
                        Height="25"
                        Margin="1,5,0,5"
                        Command="{Binding WiFiClientCommand}"
                        IsEnabled="False">
                        <Button.Content>
                            <TextBlock Foreground="{StaticResource ButtonForegroundBrush}" Text="Connect" />
                        </Button.Content>
                    </Button>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>