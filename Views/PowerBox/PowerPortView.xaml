<UserControl
    x:Class="NINA.PINS.Views.PowerBox.PowerPortView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:NINA.PINS.Resources.Converters"
    xmlns:ctrl="clr-namespace:NINA.PINS.Resources.Styles"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NINA.PINS.Views.PowerBox"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:PortIndexToVisibilityConverter x:Key="PortIndexToVisibilityConverter" />
        <!--  Port that cannot be switched (read-only, e.g. PinsBox port 0): always on  -->
        <DataTemplate x:Key="AlwaysOnTemplate">
            <ctrl:AOnPortControl
                PortCurrent="{Binding Current}"
                PortName="{Binding Index, StringFormat='12V Port #{0}'}"
                PortNumber="{Binding Index}"
                PortOvercurrent="{Binding Overcurrent}"
                PortText="{Binding Name}" />
        </DataTemplate>
        <!--  Switchable port  -->
        <DataTemplate x:Key="ControllableTemplate">
            <ctrl:PortControl
                PortBootstrap="{Binding BootState}"
                PortCurrent="{Binding Current}"
                PortName="{Binding Index, StringFormat='12V Port #{0}'}"
                PortNumber="{Binding Index}"
                PortOvercurrent="{Binding Overcurrent}"
                PortState="{Binding Enabled}"
                PortText="{Binding Name}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Environment  -->
        <ctrl:EnvHeader
            EnvCurrent="{Binding PowerSupply.Supply12A}"
            EnvDewPoint="{Binding DewPoint}"
            EnvHumidity="{Binding Humidity}"
            EnvTemperature="{Binding Temperature}"
            EnvUpTime="{Binding UpTimeFormatted}"
            EnvVoltage="{Binding PowerSupply.Supply12V}" />

        <!--  Power Ports  -->
        <GroupBox Grid.Row="1" Header="Power ports">
            <!--  Only as many rows as the box has ports; the template follows ReadOnly, which is
                  known from the port status (a DataTemplateSelector is evaluated only once)  -->
            <ItemsControl ItemsSource="{Binding PowerPorts.Ports}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Visibility">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource PortIndexToVisibilityConverter}">
                                    <Binding Path="Index" />
                                    <Binding Path="DataContext.ActualPowerPortCount" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl
                            Content="{Binding}"
                            Focusable="False"
                            IsTabStop="False">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ControllableTemplate}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReadOnly}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource AlwaysOnTemplate}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </GroupBox>

        <!--  Adj Ports  -->
        <GroupBox Grid.Row="2" Header="Adjustable ports">
            <StackPanel>
                <!--  Buck converter  -->
                <ctrl:BuckPortControl
                    PortAdjValue="{Binding BuckPorts[0].SetVoltage, Mode=TwoWay}"
                    PortCurrent="{Binding BuckPorts[0].Current}"
                    PortMaxValue="{Binding BuckPorts[0].MaxVoltage}"
                    PortMinValue="{Binding BuckPorts[0].MinVoltage}"
                    PortName="Buck converter"
                    PortNumber="{Binding BuckPorts[0].Index}"
                    PortOvercurrent="{Binding BuckPorts[0].Overcurrent}"
                    PortState="{Binding BuckPorts[0].Enabled}"
                    PortText="{Binding BuckPorts[0].Name}"
                    PortValue="{Binding BuckPorts[0].Voltage}" />
                <!--  PWM port  -->
                <ctrl:PWMPortControl
                    PortAdjValue="{Binding PWMPorts[0].SetPower, Mode=TwoWay}"
                    PortCurrent="{Binding PWMPorts[0].Current}"
                    PortDutyCycle="{Binding PWMPorts[0].Resolution}"
                    PortName="PWM port"
                    PortNumber="{Binding PWMPorts[0].Index}"
                    PortOvercurrent="{Binding PWMPorts[0].Overcurrent}"
                    PortState="{Binding PWMPorts[0].Enabled}"
                    PortText="{Binding PWMPorts[0].Name}"
                    PortValue="{Binding PWMPorts[0].Power}" />
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>