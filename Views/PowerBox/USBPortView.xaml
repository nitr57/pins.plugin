<UserControl
    x:Class="NINA.PINS.Views.PowerBox.USBPortView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:NINA.PINS.Resources.Styles"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NINA.PINS.Views.PowerBox"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Environment  -->
        <ctrl:EnvHeader
            EnvCurrent="{Binding PowerSupply.Supply12A}"
            EnvDewPoint="{Binding DewPoint}"
            EnvHumidity="{Binding Humidity}"
            EnvTemperature="{Binding Temperature}"
            EnvUpTime="{Binding UpTimeFormatted}"
            EnvVoltage="{Binding PowerSupply.Supply12V}" />

        <!--  USB Ports  -->
        <GroupBox Grid.Row="1" Header="USB ports">
            <StackPanel>
                <ctrl:PortControl
                    PortBootstrap="{Binding USBPorts[0].BootState}"
                    PortCurrent="{Binding USBPorts[0].Current}"
                    PortName="USB3 Port #1"
                    PortNumber="{Binding USBPorts[0].Index}"
                    PortOvercurrent="{Binding USBPorts[0].OverCurrent}"
                    PortState="{Binding USBPorts[0].Enabled}"
                    PortText="{Binding USBPorts[0].Name}" />
                <ctrl:PortControl
                    PortBootstrap="{Binding USBPorts[1].BootState}"
                    PortCurrent="{Binding USBPorts[1].Current}"
                    PortName="USB3 Port #2"
                    PortNumber="{Binding USBPorts[1].Index}"
                    PortOvercurrent="{Binding USBPorts[1].Overcurrent}"
                    PortState="{Binding USBPorts[1].Enabled}"
                    PortText="{Binding USBPorts[1].Name}" />
                <ctrl:PortControl
                    PortBootstrap="{Binding USBPorts[2].BootState}"
                    PortCurrent="{Binding USBPorts[2].Current}"
                    PortName="USB3 Port #3"
                    PortNumber="{Binding USBPorts[2].Index}"
                    PortOvercurrent="{Binding USBPorts[2].Overcurrent}"
                    PortState="{Binding USBPorts[2].Enabled}"
                    PortText="{Binding USBPorts[2].Name}" />
                <ctrl:PortControl
                    PortBootstrap="{Binding USBPorts[3].BootState}"
                    PortCurrent="{Binding USBPorts[3].Current}"
                    PortName="USB3 Port #4"
                    PortNumber="{Binding USBPorts[3].Index}"
                    PortOvercurrent="{Binding USBPorts[3].Overcurrent}"
                    PortState="{Binding USBPorts[3].Enabled}"
                    PortText="{Binding USBPorts[3].Name}" />
                <ctrl:PortControl
                    PortBootstrap="{Binding USBPorts[4].BootState}"
                    PortCurrent="{Binding USBPorts[4].Current}"
                    PortName="USB2 Port #1"
                    PortNumber="{Binding USBPorts[4].Index}"
                    PortOvercurrent="{Binding USBPorts[4].Overcurrent}"
                    PortState="{Binding USBPorts[4].Enabled}"
                    PortText="{Binding USBPorts[4].Name}" />
                <ctrl:PortControl
                    PortBootstrap="{Binding USBPorts[5].BootState}"
                    PortCurrent="{Binding USBPorts[5].Current}"
                    PortName="USB2 Port #2"
                    PortNumber="{Binding USBPorts[5].Index}"
                    PortOvercurrent="{Binding USBPorts[5].Overcurrent}"
                    PortState="{Binding USBPorts[5].Enabled}"
                    PortText="{Binding USBPorts[5].Name}" />
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>