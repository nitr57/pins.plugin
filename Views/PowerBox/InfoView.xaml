<UserControl
    x:Class="NINA.PINS.Views.PowerBox.InfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:NINA.PINS.Resources.Styles"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NINA.PINS.Views.PowerBox"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary"
    xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core"
    xmlns:util="clr-namespace:NINA.Core.Utility.ValidationRules;assembly=NINA.Core"
    xmlns:view="clr-namespace:NINA.PINS.Views"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Environment  -->
            <ctrl:EnvHeader
                EnvCurrent="{Binding PowerSupply.Supply12A}"
                EnvDewPoint="{Binding DewPoint}"
                EnvHumidity="{Binding Humidity}"
                EnvTemperature="{Binding Temperature}"
                EnvUpTime="{Binding UpTimeFormatted}"
                EnvVoltage="{Binding PowerSupply.Supply12V}" />

            <UniformGrid Grid.Row="1" Rows="2">
                <UniformGrid Columns="2">
                    <GroupBox>
                        <GroupBox.Header>
                            <Grid Height="40" Margin="5">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="Device Information" />
                            </Grid>
                        </GroupBox.Header>
                        <Grid>
                            <StackPanel>
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontWeight="DemiBold"
                                    Text="12V rail" />
                                <Border BorderThickness="0">
                                    <UniformGrid
                                        Margin="0,6,0,6"
                                        VerticalAlignment="Center"
                                        Columns="3">
                                        <TextBlock Text="Voltage" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            Text="{Binding PowerSupply.Supply12V, StringFormat='{}{0} V'}"
                                            TextWrapping="WrapWithOverflow" />
                                    </UniformGrid>
                                </Border>
                                <Border BorderThickness="0">
                                    <UniformGrid
                                        Margin="0,6,0,6"
                                        VerticalAlignment="Center"
                                        Columns="3">
                                        <TextBlock Text="Current" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            Text="{Binding PowerSupply.Supply12A, StringFormat='{}{0} A'}"
                                            TextWrapping="WrapWithOverflow" />
                                    </UniformGrid>
                                </Border>
                                <Border BorderThickness="0">
                                    <UniformGrid
                                        Margin="0,6,0,6"
                                        VerticalAlignment="Center"
                                        Columns="3">
                                        <TextBlock Text="Power" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            Text="{Binding PowerSupply.Supply12W, StringFormat='{}{0} W'}"
                                            TextWrapping="WrapWithOverflow" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontWeight="DemiBold"
                                    Text="5V rail" />
                                <Border BorderThickness="0">
                                    <UniformGrid
                                        Margin="0,6,0,6"
                                        VerticalAlignment="Center"
                                        Columns="3">
                                        <TextBlock Text="Voltage" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            Text="{Binding PowerSupply.Supply5V, StringFormat='{}{0} V'}"
                                            TextWrapping="WrapWithOverflow" />
                                    </UniformGrid>
                                </Border>
                                <Border BorderThickness="0">
                                    <UniformGrid
                                        Margin="0,6,0,6"
                                        VerticalAlignment="Center"
                                        Columns="3">
                                        <TextBlock Text="Current" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            Text="{Binding Supply5A, StringFormat='{}{0} A'}"
                                            TextWrapping="WrapWithOverflow" />
                                    </UniformGrid>
                                </Border>
                                <Border BorderThickness="0">
                                    <UniformGrid
                                        Margin="0,6,0,6"
                                        VerticalAlignment="Center"
                                        Columns="3">
                                        <TextBlock Text="Power" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            Text="{Binding Supply5W, StringFormat='{}{0} W'}"
                                            TextWrapping="WrapWithOverflow" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontWeight="DemiBold"
                                    Text="Statistics" />
                                <Border BorderThickness="0">
                                    <UniformGrid
                                        Margin="0,6,0,6"
                                        VerticalAlignment="Center"
                                        Columns="3">
                                        <TextBlock Text="Watts/hr" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            Text="{Binding PowerSupply.WattsPerHour, StringFormat='{}{0} Wh'}"
                                            TextWrapping="WrapWithOverflow" />
                                    </UniformGrid>
                                </Border>
                                <Border BorderThickness="0">
                                    <UniformGrid
                                        Margin="0,6,0,6"
                                        VerticalAlignment="Center"
                                        Columns="3">
                                        <TextBlock Text="Amps/hr" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            Text="{Binding PowerSupply.AmpsPerHour, StringFormat='{}{0} Ah'}"
                                            TextWrapping="WrapWithOverflow" />
                                    </UniformGrid>
                                </Border>
                                <Border BorderThickness="0">
                                    <UniformGrid
                                        Margin="0,6,0,6"
                                        VerticalAlignment="Center"
                                        Columns="3">
                                        <TextBlock Text="Avg. Amps" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            Text="{Binding AverageAmps, StringFormat='{}{0} A'}"
                                            TextWrapping="WrapWithOverflow" />
                                    </UniformGrid>
                                </Border>
                                <!--  External sensor  -->
                                <Border BorderThickness="0">
                                    <UniformGrid
                                        Margin="0,6,0,6"
                                        VerticalAlignment="Center"
                                        Columns="3">
                                        <TextBlock Text="External sensor" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            Text="{Binding ExtSensor}"
                                            TextWrapping="WrapWithOverflow" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                    <GroupBox>
                        <GroupBox.Header>
                            <Grid Height="40" Margin="5">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="" />
                            </Grid>
                        </GroupBox.Header>
                        <view:InfoView />
                    </GroupBox>
                </UniformGrid>
                <UniformGrid Columns="2">
                    <GroupBox>
                        <GroupBox.Header>
                            <Grid Height="40" Margin="5">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="Configuration" />
                            </Grid>
                        </GroupBox.Header>
                        <Grid>
                            <StackPanel>
                                <!--  Temperature offset  -->
                                <ctrl:PropertyConfig
                                    PropertyMax="12.5"
                                    PropertyMin="-12.5"
                                    PropertyName="Temperature offset"
                                    PropertyUnit="°C"
                                    PropertyValue="{Binding TemperatureOffset, Mode=TwoWay}" />

                                <!--  Humidity offset  -->
                                <ctrl:PropertyConfig
                                    PropertyMax="12.5"
                                    PropertyMin="-12.5"
                                    PropertyName="Humidity offset"
                                    PropertyUnit="%"
                                    PropertyValue="{Binding HumidityOffset, Mode=TwoWay}" />

                                <!--  Env Update rate  -->
                                <ctrl:PropertyConfig
                                    PropertyMax="60"
                                    PropertyMin="1"
                                    PropertyName="Environment update rate"
                                    PropertyUnit="s"
                                    PropertyValue="{Binding EnvUpdateRate, Mode=TwoWay}" />

                                <!--  Update rate  -->
                                <ctrl:PropertyConfig
                                    PropertyMax="60"
                                    PropertyMin="1"
                                    PropertyName="Device update rate"
                                    PropertyUnit="s"
                                    PropertyValue="{Binding UpdateRate, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </UniformGrid>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>