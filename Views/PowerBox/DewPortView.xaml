<UserControl
    x:Class="NINA.PINS.Views.PowerBox.DewPortView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:NINA.PINS.Resources.Styles"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NINA.PINS.Views.PowerBox"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Environment  -->
        <ctrl:EnvHeader
            EnvCurrent="{Binding PowerSupply.Supply12A}"
            EnvDewPoint="{Binding DewPoint}"
            EnvHumidity="{Binding Humidity}"
            EnvTemperature="{Binding Temperature}"
            EnvUpTime="{Binding UpTimeFormatted}"
            EnvVoltage="{Binding PowerSupply.Supply12V}" />

        <!--  Dew Ports  -->
        <GroupBox
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Header="Dew ports">
            <StackPanel>
                <ctrl:DewControl
                    PortAutoDew="{Binding DewPorts[0].AutoMode, Mode=TwoWay}"
                    PortCurrent="{Binding DewPorts[0].Current}"
                    PortDeltaT="{Binding DewPorts[0].AutoThreshold, Mode=TwoWay}"
                    PortDutyCycle="{Binding DewPorts[0].Resolution}"
                    PortName="Dew Port #1"
                    PortNumber="{Binding DewPorts[0].Index}"
                    PortOvercurrent="{Binding DewPorts[0].OverCurrent}"
                    PortSetPower="{Binding DewPorts[0].SetPower, Mode=TwoWay}"
                    PortState="{Binding DewPorts[0].Enabled, Mode=TwoWay}"
                    PortTemperature="{Binding DewPorts[0].Probe}"
                    PortText="{Binding DewPorts[0].Name}"
                    PortValue="{Binding DewPorts[0].Power}" />
                <ctrl:DewControl
                    PortAutoDew="{Binding DewPorts[1].AutoMode, Mode=TwoWay}"
                    PortCurrent="{Binding DewPorts[1].Current}"
                    PortDeltaT="{Binding DewPorts[1].AutoThreshold, Mode=TwoWay}"
                    PortDutyCycle="{Binding DewPorts[1].Resolution}"
                    PortName="Dew Port #2"
                    PortNumber="{Binding DewPorts[1].Index}"
                    PortOvercurrent="{Binding DewPorts[1].OverCurrent}"
                    PortSetPower="{Binding DewPorts[1].SetPower, Mode=TwoWay}"
                    PortState="{Binding DewPorts[1].Enabled, Mode=TwoWay}"
                    PortTemperature="{Binding DewPorts[1].Probe}"
                    PortText="{Binding DewPorts[1].Name}"
                    PortValue="{Binding DewPorts[1].Power}" />
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>